{
  "name": "Telegram Calendar Bot",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        304
      ],
      "webhookId": "",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": ""
        }
      }
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": ""
        },
        "start": "={{ $json.output.start }}",
        "end": "={{ $json.output.end }}",
        "useDefaultReminders": false,
        "additionalFields": {
          "summary": "={{ $json.output.title }}"
        },
        "remindersUi": {
          "remindersValues": [
            {
              "method": "popup",
              "minutes": 1440
            }
          ]
        }
      },
      "id": "",
      "name": "Create Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        816,
        304
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $(\"Telegram Trigger\").item.json.message.chat.id }}",
        "text": "=✅ *Rendez-vous créé !*\n\n📌 *{{ $json.summary }}*\n📅 Date : {{ $('Extract Event Info').item.json.output.date }}\n🕐 Heure : {{ $('Extract Event Info').item.json.output.time }}\n\n🔔 Tu seras notifié 1 jour avant et 1 heure avant.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "",
      "name": "Send Confirmation",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1040,
        304
      ],
      "webhookId": "",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "text": "={{ $json.message.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "title",
              "description": "The title or name of the event",
              "required": true
            },
            {
              "name": "date",
              "description": "The date in YYYY-MM-DD format. Current year is 2026. Convert DD/MM to YYYY-MM-DD.",
              "required": true
            },
            {
              "name": "time",
              "description": "The time in HH:MM format (24-hour)",
              "required": true
            },
            {
              "name": "start",
              "description": "The start datetime in YYYY-MM-DDTHH:MM:00 format",
              "required": true
            },
            {
              "name": "end",
              "description": "The end datetime in YYYY-MM-DDTHH:MM:00 format (1 hour after start)",
              "required": true
            }
          ]
        },
        "options": {}
      },
      "id": "",
      "name": "Extract Event Info",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0
        }
      },
      "id": "",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        544,
        528
      ],
      "credentials": {
        "groqApi": {
          "id": "",
          "name": "Groq account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Extract Event Info",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Calendar Event": {
      "main": [
        [
          {
            "node": "Send Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Event Info": {
      "main": [
        [
          {
            "node": "Create Calendar Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Extract Event Info",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "versionId": "",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": ""
  },
  "id": "",
  "tags": []
}